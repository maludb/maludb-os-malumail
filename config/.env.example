# MaluMail — config/.env (written by the kernel's installer at apply; the five ports, ML_MAILER_KEY and ML_SEAL_PUBLIC_KEY pinned
# first by deploy/ROOT_STEPS.sh; design §14). Never commit the real file. Group www-data reads it; nothing in it is ever logged,
# printed or returned. NOT HERE, EVER: the sealing SECRET key and MALUMAIL_MAILBOX_API_KEY (the customer key with the Mailbox MCP) —
# they live in /etc/malumail/mailer.env (0400, user malumail-mailer), read only by the mail service. PHP holds no MaluMail secret
# that opens a mailbox.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="MaluMail"
APP_KEY=malumail
APP_URL=https://webmail.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_malumail
DB_USER=malumail_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=malumail_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=malumail_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (all five pinned before the first apply: deploy/ROOT_STEPS.sh — the installer assigns only APP_INTERNAL_PORT and the MCP
# endpoints' ports, never the mail service's or the image door's; design §14, D16)
APP_INTERNAL_PORT=8199
MCP_RECORDS_PORT=8852
MCP_ACTIVITY_PORT=8853
ML_MAILER_PORT=8854
ML_IMAGES_PORT=8855
# the mail service's door (loopback only): PHP signs every call to it with this key (32 random bytes, hex; ROOT_STEPS.sh writes it
# once and copies it into /etc/malumail/mailer.env). The service refuses an unsigned or stale call (design §6.1).
ML_MAILER_KEY=
# the sealing PUBLIC key (libsodium crypto_box_seal, base64; ROOT_STEPS.sh makes the pair): PHP seals a mailbox password the moment
# MaluMail returns it and can never open it again — the secret key is the mail service's alone (design §6.2)
ML_SEAL_PUBLIC_KEY=
# signs the one-hour attachment and image links (/p/, /img/); written once by deploy/ROOT_STEPS.sh
ML_PART_KEY=
# the mail service's ceiling on open IMAP connections across every mailbox (Dovecot allows ten per address)
ML_MAILER_MAX_CONNECTIONS=400
# MaluMail (design §6.1): the Mailbox MCP for administration (through the mail service only) and the mail servers for content
MALUMAIL_MCP_URL=https://api.malumail.com/mcp
ML_IMAP_HOST=mbox01.malumail.com
ML_IMAP_PORT=993
ML_SMTP_HOST=mbox01.malumail.com
ML_SMTP_PORT=587
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes: ids, never mail text — D14) — MaluMail keeps no memory database of its own
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# notification mail (optional; the installer fills them from ~/.malumail or the kernel's) — the bell's mail copies only, sent through
# MaluMail's REST API like every sibling's; this key opens no mailbox and is never the customer key above
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# the attachment store: a draft's attachments until the message is sent (default storage/ under the application; www-data writes it)
ML_STORAGE_DIR=storage
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
