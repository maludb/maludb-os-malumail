[Unit]
Description=MaluMail records MCP server (FastMCP, loopback :{{MCP_RECORDS_PORT}}) — Phase 4
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory={{APP_DIR}}/mcp
ExecStart={{APP_DIR}}/mcp/venv/bin/python {{APP_DIR}}/mcp/records_mcp.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
