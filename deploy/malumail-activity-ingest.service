[Unit]
Description=MaluMail activity log -> the tenant's MaluDB (one pass; ids and counts, never mail text — design §6.6, D14)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory={{APP_DIR}}
ExecStart={{APP_DIR}}/mcp/venv/bin/python {{APP_DIR}}/mcp/activity_ingest.py
